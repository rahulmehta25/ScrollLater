{
  "manifest_version": 3,
  "name": "ScrollLater - Save for Later",
  "short_name": "ScrollLater",
  "version": "1.0.0",
  "description": "Save articles, videos, and content to read later. Quick save with one click.",
  "author": "ScrollLater",
  "homepage_url": "https://scrolllater.com",

  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg",
      "48": "icons/icon-48.svg"
    },
    "default_title": "Save to ScrollLater"
  },

  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications"
  ],

  "host_permissions": [
    "https://scrolllater.com/*"
  ],

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open ScrollLater popup"
    },
    "quick-save": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Option+S"
      },
      "description": "Quick save current page"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "default_locale": "en"
}
