# ScrollLater environment template.
# Copy to .env.local and fill the blanks.

# Supabase (auth, realtime, edge functions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostHog (optional — falls back to shared portfolio key if unset)
NEXT_PUBLIC_POSTHOG_KEY=phc_MdeB4wNRGn9gckJkl0ZZDh1XEIlvsfWBa23qv9lty5Z
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ElevenLabs (audio narrator agent)
ELEVENLABS_API_KEY=
ELEVENLABS_NARRATOR_AGENT_ID=agent_2001kpfrb0zrektav0a1vrtpjhsj

# Cloud SQL portfolio-pg / scrolllater database.
# Used by scripts/seed-scrolllater.ts and the upcoming audio pipeline worker.
#   1. Run scripts/db-proxy.sh in another terminal (brew install cloud-sql-proxy).
#   2. gcloud secrets versions access latest --secret=portfolio-pg-postgres-password \
#        --project=osmoti-auth
#   3. Replace CHANGEME with that password.
DATABASE_URL=postgresql://postgres:CHANGEME@127.0.0.1:5432/scrolllater?sslmode=disable

# Google Cloud Storage bucket for generated MP3 audio (see schema entries.audio_gs_url).
GCS_AUDIO_BUCKET=scrolllater-audio-us-east1
